#!/bin/sh

printf 'Content-Type: text/plain; charset=UTF-8\r\n'
printf '\r\n'

printf 'Hiii! Welcome to Linh CGI Lab!\n'
printf 'This little greeting is generated by a CGI script.\n'
printf 'Greetings from Khanh Linh - VKU (24IT138)!\n'
printf '\n'

printf 'Request Method: %s\n' "${REQUEST_METHOD:-unknown}"
printf 'Query String: %s\n' "${QUERY_STRING:-}"
printf 'Server Protocol: %s\n' "${SERVER_PROTOCOL:-unknown}"
